# Exemplo de variaveis para docker compose.
# Copie este arquivo para .env e ajuste antes de executar inferencia.

# Nome do arquivo dentro de /app/data/input/
INPUT_FILE=amostra_ssp.csv

# RUN_ID da execucao de treino que sera usada na inferencia.
# Exemplo: 20260329_142530
RUN_ID=__SET_RUN_ID__

# Diretorio de saida da inferencia dentro de /app/outputs/
INFER_OUTPUT_DIR=inference_output

# Usado apenas pelos servicos com profile GPU (train-gpu / infer-gpu).
TF_DEVICE=gpu
